<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToD.Wait"
             BackgroundColor="#6200EE"
             Title="Wait">
    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
        <Image Source="logot.png" WidthRequest="100" HeightRequest="100" />
        <Label Text="Je bent succesvol verbonden! 🚀" 
           FontSize="20" 
           HorizontalTextAlignment="Center" 
           Margin="0,10,0,0" />
        <Label Text="De host start de sessie binnenkort. Wacht geduldig en maak je alvast klaar!"
           FontSize="16" 
           HorizontalTextAlignment="Center" 
           Margin="20,5,20,0" />
        <ActivityIndicator IsRunning="True" Color="#F5D547" Margin="0,20,0,0" />
    </VerticalStackLayout>
</ContentPage>