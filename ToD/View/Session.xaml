<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModel="clr-namespace:ToD.ViewModel"
             x:Class="ToD.Session"
             Title="Session">

    <ContentPage.BindingContext>
        <viewModel:SessionViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Spacing="10" Padding="20" HorizontalOptions="Fill" VerticalOptions="Fill">

        <!-- QR Code -->
        <Image Source="qrcode_placeholder.png" WidthRequest="250" HeightRequest="250" HorizontalOptions="Center" />

        <!-- Titel leden -->
        <Label Text="Leden"
               BackgroundColor="LightGray"
               HorizontalTextAlignment="Center"
               FontSize="Medium" />

        <!-- Toevoegen van leden -->
        <HorizontalStackLayout>
            <Entry x:Name="MemberEntry" Placeholder="Voer naam in" WidthRequest="200" />
            <Button Text="+" 
                    BackgroundColor="#AAAAAA" 
                    TextColor="White" 
                    Clicked="OnAddMemberClicked" />
        </HorizontalStackLayout>

        <!-- Dynamische lijst van leden -->
        <ListView ItemsSource="{Binding Members}" Margin="0,10,0,10" HeightRequest="150">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <StackLayout Orientation="Horizontal" Padding="10">
                            <Label Text="{Binding}" FontSize="Medium" VerticalOptions="CenterAndExpand" />

                            <!-- Bewerken knop -->
                            <Button Text="Bewerken" BackgroundColor="Yellow" TextColor="Black" 
                                    WidthRequest="80" Clicked="OnEditMemberClicked" 
                                    CommandParameter="{Binding}" VerticalOptions="Center" />

                            <!-- Verwijder knop -->
                            <Button Text="Verwijderen" BackgroundColor="Red" TextColor="White" 
                                    WidthRequest="100" Clicked="OnRemoveMemberClicked" 
                                    CommandParameter="{Binding}" VerticalOptions="Center" />
                        </StackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackLayout VerticalOptions="End" Orientation="Horizontal" Spacing="2" Padding="10">
            <Button Text="Waarheid" HorizontalOptions="End" BackgroundColor="AntiqueWhite" TextColor="Black" Command="{Binding SelectCategoryCommand}" CommandParameter="Waarheid">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding SelectedCategories}" Value="Waarheid">
                        <Setter Property="BackgroundColor" Value="LightGreen"/>
                        <Setter Property="TextColor" Value="White"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Button Text="Would You Rather" HorizontalOptions="FillAndExpand" BackgroundColor="AntiqueWhite" TextColor="Black" Command="{Binding SelectCategoryCommand}" CommandParameter="Would You Rather">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding SelectedCategories}" Value="Would You Rather">
                        <Setter Property="BackgroundColor" Value="LightGreen"/>
                        <Setter Property="TextColor" Value="White"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Button Text="Uitdaging" HorizontalOptions="End" BackgroundColor="AntiqueWhite" TextColor="Black" Command="{Binding SelectCategoryCommand}" CommandParameter="Uitdaging">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding SelectedCategories}" Value="Uitdaging">
                        <Setter Property="BackgroundColor" Value="LightGreen"/>
                        <Setter Property="TextColor" Value="White"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </StackLayout>




        <!-- Start Button -->
        <Button x:Name="Start"
                Text="Start" 
                Clicked="Start_Clicked" 
                BackgroundColor="Green" 
                TextColor="White" 
                HorizontalOptions="Fill" />

    </VerticalStackLayout>
</ContentPage>
