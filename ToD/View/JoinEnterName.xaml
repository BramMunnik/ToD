<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToD.JoinEnterName"
             Title="JoinEnterName"
             BackgroundColor="#6200EE">
    
    <VerticalStackLayout Spacing="20" Padding="30" HorizontalOptions="Center" VerticalOptions="Center">
        <Label Text="Truth or drink"
               FontSize="24"
               HorizontalOptions="Center" />

        <Label Text="Jouw naam"
               FontSize="18"
               HorizontalOptions="Start" />

        <Entry x:Name="NameEntry"
               Placeholder="Jouw naam"
               FontSize="16"
               BackgroundColor="#E0E0E0"
               HeightRequest="40"
               HorizontalOptions="FillAndExpand" />

        <Button Text="Deelnemen"
                x:Name="JoinSession"
                FontSize="18"
                BackgroundColor="#E0E0E0"
                TextColor="Black"
                Clicked="OnJoinClicked"
                HorizontalOptions="FillAndExpand" />
    </VerticalStackLayout>
</ContentPage>