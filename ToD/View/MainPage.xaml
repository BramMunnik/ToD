<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="#6200EE"
             x:Class="ToD.MainPage">

    <VerticalStackLayout Padding="20" Spacing="15" VerticalOptions="Center">
        <Image Source="logot.png" WidthRequest="200" HeightRequest="200" />
        <Button Text="Start spel" 
                BackgroundColor="#FF6E1F" 
                TextColor="White" 
                HorizontalOptions="Center"
                Clicked="GoToSessionButton_Clicked" 
                WidthRequest="200" 
                HeightRequest="60"
                FontSize="Large" />
        <Button Text="Deelnemen" 
                BackgroundColor="#FF6E1F" 
                TextColor="White" 
                HorizontalOptions="Center"
                Clicked="JoinSessionButton_Clicked" 
                WidthRequest="200" 
                HeightRequest="60"
                FontSize="Large" />
    </VerticalStackLayout>
</ContentPage>
