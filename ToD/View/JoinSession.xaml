<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToD.JoinSession"
             BackgroundColor="#6200EE"
             Title="JoinSession">
    
    <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">

        <Label Text="Truth or Drink"
               FontSize="30"
               HorizontalOptions="Center" />

        <!-- Room code invoer -->
        <StackLayout HorizontalOptions="Center" WidthRequest="200">
            <Label Text="Vul sessie nummer in"
                   FontSize="16"
                   HorizontalOptions="Start" />
            <Entry Placeholder="Sessie nummer"
                   BackgroundColor="#E0E0E0"
                   HorizontalOptions="FillAndExpand" />
        </StackLayout>

        <!-- Join knop -->
        <Button Text="Deelnemen"
                x:Name="JoinButton"
                BackgroundColor="#E0E0E0"
                TextColor="Black"
                WidthRequest="150"
                HeightRequest="50"
                Clicked="JoinName_Clicked"
                HorizontalOptions="Center" />
    </StackLayout>
</ContentPage>