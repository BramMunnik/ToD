<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToD.GamePage"
             BackgroundColor="#6200EE"
             Title="Game">

    <StackLayout Padding="20" Spacing="30">
        <Label Text="Truth or Drink"
               FontSize="28"
               HorizontalOptions="Center" />

        <Frame BackgroundColor="White" CornerRadius="10" Padding="10">
            <Label Text="{Binding CurrentPlayer}" 
                   FontSize="24" 
                   HorizontalOptions="Center" />
        </Frame>

        <Frame BackgroundColor="White" CornerRadius="10" Padding="10">
            <Label Text="{Binding CurrentQuestion}" 
                   FontSize="18"
                   HorizontalTextAlignment="Center" />
        </Frame>

        <!-- Knop met standaardtekst en -command -->
        <Button Text="Truth"
                BackgroundColor="White"
                TextColor="Black"
                Command="{Binding ChooseTruthCommand}">
            <Button.Triggers>
                <!-- DataTrigger voor camera-opdrachten -->
                <DataTrigger TargetType="Button" Binding="{Binding RequiresCamera}" Value="True">
                    <Setter Property="Text" Value="Camera" />
                    <Setter Property="Command" Value="{Binding UseCameraCommand}" />
                </DataTrigger>
            </Button.Triggers>
        </Button>

        <Button Text="Drink"
                BackgroundColor="White"
                TextColor="Black"
                Command="{Binding ChooseDrinkCommand}" />

        <Button Text="End Game"
                BackgroundColor="White"
                TextColor="Black"
                Command="{Binding EndGameCommand}" />
    </StackLayout>
</ContentPage>
