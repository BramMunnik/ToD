<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToD.CustomQuestionPage"
             Title="Add Custom Question">

    <StackLayout Padding="20" Spacing="20">
        <Button Text="Add Question"
                BackgroundColor="Gray"
                TextColor="White"
                HorizontalOptions="Center" />

        <Label Text="Question" 
               FontSize="18" 
               HorizontalOptions="Start" />
        <Entry x:Name="QuestionEntry"
               Placeholder="Enter your question here"
               PlaceholderColor="LightGray"
               BackgroundColor="LightGray" />

        <Label Text="Riskiness" 
               FontSize="18" 
               HorizontalOptions="Start" />
        <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
            <ImageButton x:Name="Star1" StyleId="1" Source="star_empty.png" 
                         Clicked="StarClicked" WidthRequest="30" HeightRequest="30" />
            <ImageButton x:Name="Star2" StyleId="2" Source="star_empty.png" 
                         Clicked="StarClicked" WidthRequest="30" HeightRequest="30" />
            <ImageButton x:Name="Star3" StyleId="3" Source="star_empty.png" 
                         Clicked="StarClicked" WidthRequest="30" HeightRequest="30" />
            <ImageButton x:Name="Star4" StyleId="4" Source="star_empty.png" 
                         Clicked="StarClicked" WidthRequest="30" HeightRequest="30" />
            <ImageButton x:Name="Star5" StyleId="5" Source="star_empty.png" 
                         Clicked="StarClicked" WidthRequest="30" HeightRequest="30" />
        </HorizontalStackLayout>

        <Button Text="Save"
                BackgroundColor="LightGray"
                TextColor="Black"
                Clicked="OnSaveClicked" />
    </StackLayout>
</ContentPage>
