<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToD.CreateSessionPage"
             Title="Create a Session">
    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">
            <!-- Titel -->
            <Label Text="Create Your Game Session"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <!-- Categorieën selecteren -->
            <Label Text="Select Categories:" FontSize="18" />
            <CollectionView ItemsSource="{Binding Categories}" SelectionMode="Multiple">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="Gray" Padding="10" Margin="5">
                            <Label Text="{Binding Name}" HorizontalOptions="Center" />
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Gewaagdheid instellen -->
            <Label Text="Set Boldness Level (1-5 Stars):" FontSize="18" />
            <Slider Minimum="1" Maximum="5" Value="{Binding Boldness}" />

            <!-- Voorgestelde of gepersonaliseerde vragen -->
            <Label Text="Choose Question Type:" FontSize="18" />
            <Picker ItemsSource="{Binding QuestionTypes}" 
                    SelectedItem="{Binding SelectedQuestionType}" />

            <!-- Code invoeren voor vragen van deelnemers -->
            <Label Text="Add Questions via Code:" FontSize="18" />
            <HorizontalStackLayout>
                <Entry Placeholder="Enter Code" Text="{Binding ParticipantCode}" />
                <Button Text="Add" Command="{Binding AddQuestionsCommand}" />
            </HorizontalStackLayout>

            <!-- Start de sessie -->
            <Button Text="Start Session" Command="{Binding StartSessionCommand}" BackgroundColor="Green" TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
