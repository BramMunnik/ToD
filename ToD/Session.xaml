<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ToD"
             x:Class="ToD.Session"
             Title="Session">

    <ContentPage.BindingContext>
        <local:SessionViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Spacing="10" Padding="20" HorizontalOptions="Center" VerticalOptions="Center">

        <!-- QR Code -->
        <Image Source="qrcode_placeholder.png" WidthRequest="250" HeightRequest="250" />

        <!-- Titel leden -->
        <Label Text="Leden" 
               BackgroundColor="LightGray" 
               HorizontalTextAlignment="Center"
               FontSize="Medium" />

        <!-- Toevoegen van leden -->
        <HorizontalStackLayout>
            <Entry x:Name="MemberEntry" Placeholder="Voer naam in" WidthRequest="200" />
            <Button Text="+" 
                    BackgroundColor="#AAAAAA" 
                    TextColor="White" 
                    Clicked="OnAddMemberClicked" />
        </HorizontalStackLayout>

        <!-- Dynamische lijst van leden -->
        <ListView ItemsSource="{Binding Members}" Margin="0,10,0,10" HeightRequest="150">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <StackLayout Orientation="Horizontal" Padding="10">
                            <Label Text="{Binding}" FontSize="Medium" VerticalOptions="CenterAndExpand" />

                            <!-- Bewerken knop -->
                            <Button Text="Bewerken" BackgroundColor="Yellow" TextColor="Black" 
                                    WidthRequest="80" Clicked="OnEditMemberClicked" 
                                    CommandParameter="{Binding}" VerticalOptions="Center" />

                            <!-- Verwijder knop -->
                            <Button Text="Verwijderen" BackgroundColor="Red" TextColor="White" 
                                    WidthRequest="100" Clicked="OnRemoveMemberClicked" 
                                    CommandParameter="{Binding}" VerticalOptions="Center" />
                        </StackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Questions Button -->
        <Button x:Name="Questions"
                Text="Questions"
                Clicked="Questions_Clicked" 
                BackgroundColor="LightGray" 
                TextColor="Black" 
                HorizontalOptions="Fill" />

        <!-- Start Button -->
        <Button Text="Start" 
                BackgroundColor="Green" 
                TextColor="White" 
                HorizontalOptions="Fill" />

    </VerticalStackLayout>
</ContentPage>
