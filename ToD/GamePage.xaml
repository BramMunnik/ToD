<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToD.GamePage"
             Title="Game Page">

    <StackLayout Padding="20" Spacing="30">
        <Label Text="Truth or Drink"
               FontSize="28"
               HorizontalOptions="Center" />

        <Frame BackgroundColor="LightGray" CornerRadius="10" Padding="10">
            <Label Text="{Binding CurrentPlayer}" 
                   FontSize="24" 
                   HorizontalOptions="Center" />
        </Frame>

        <Frame BackgroundColor="LightGray" CornerRadius="10" Padding="10">
            <Label Text="{Binding CurrentQuestion}" 
                   FontSize="18"
                   HorizontalTextAlignment="Center" />
        </Frame>

        <Button Text="Next"
                BackgroundColor="DarkGray"
                TextColor="White"
                Clicked="OnNextClicked" />

        <Button Text="End Game"
                BackgroundColor="DarkGray"
                TextColor="White"
                Clicked="OnEndGameClicked" />
    </StackLayout>
</ContentPage>
